# Server only. Never add these values to frontend code or source control.
PORT=3000
HOST=::1
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional: Better Auth Infrastructure dashboard connection (enables dash()).
BETTER_AUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUCAM_API_KEY=
# Required: Supabase > Connect > copy a PostgreSQL connection URI.
# Example: postgresql://user:password@host:5432/presew?sslmode=require
# Use the Session pooler when your network is IPv4-only.
# Keep presew and presew_auth OUT of the Supabase Data API exposed-schema list.
DATABASE_URL=
PRIVATE_STORAGE_PATH=.data/assets
MAX_RENDERS_PER_DAY=5
